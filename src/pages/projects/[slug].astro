---
// src/pages/projects/[slug].astro
import type { InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import { ArrowDownIcon } from 'lucide-react';
import { ImageGallery } from '@/components/ImageGallery';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import Layout from '@/layouts/Layout.astro';
import { buildGalleryImages } from '@/lib/gallery';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { project } = Astro.props;
const { title, summary, description, client, year, tags, images } =
  project.data;

const galleryImages = await buildGalleryImages(images);
---

<Layout title={title} description={summary}>
  <article class="flex flex-col gap-10">
    <header class="flex flex-col gap-4">
      <h1 class="text-3xl font-medium tracking-tight">{title}</h1>
      <p class="max-w-2xl text-lg text-muted-foreground">{summary}</p>
      <dl class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
        <div>
          <dt class="text-muted-foreground">Client</dt>
          <dd class="font-medium">{client}</dd>
        </div>
        <div>
          <dt class="text-muted-foreground">Year</dt>
          <dd class="font-medium">{year}</dd>
        </div>
      </dl>
      <ul class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li>
            <Badge variant="secondary">{tag}</Badge>
          </li>
        ))}
      </ul>
      <div>
        <a href="#gallery" class={buttonVariants({ variant: 'default' })}>
          View Gallery
          <ArrowDownIcon />
        </a>
      </div>
    </header>

    <p class="max-w-2xl">{description}</p>

    <section
      id="gallery"
      aria-labelledby="gallery-heading"
      class="flex scroll-mt-8 flex-col gap-4">
      <h2 id="gallery-heading" class="text-2xl font-medium">
        Gallery
      </h2>
      <ImageGallery client:visible images={galleryImages} />
    </section>
  </article>
</Layout>
